{
  "name": "Homelab Portal",
  "image": "ghcr.io/mmalyska/dev-workstation:1.0.0@sha256:71335a56b4a6dd99f9105da136395963f24fd40f4832a0ce4d54e46b725e6fb5",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    },
    "ghcr.io/casl0/devcontainer-features/android-sdk:1": {
      "platformsVersion": "35",
      "buildToolsVersion": "35.0.0"
    }
  },
  "containerEnv": {
    "MISE_DISABLE_TOOLS": "node",
    "ANDROID_HOME": "/usr/local/android"
  },
  "initializeCommand": "test -f .devcontainer/devcontainer.env || cp .devcontainer/devcontainer.env.sample .devcontainer/devcontainer.env",
  "postCreateCommand": "yarn install && chezmoi init --apply https://github.com/mmalyska/dotfiles.git",
  "updateContentCommand": "yarn install",
  "runArgs": ["--env-file", ".devcontainer/devcontainer.env"],
  "secrets": {
    "ANDROID_DEBUG_KEYSTORE_PASSWORD": {
      "description": "Optional: custom debug keystore password. Leave unset to use the default Android debug keystore."
    },
    "GITHUB_TOKEN": {
      "description": "GitHub personal access token for gh CLI. In Codespaces, this is injected automatically."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "msjsdiag.vscode-react-native",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.preferences.importModuleSpecifier": "relative"
      }
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode"
}
