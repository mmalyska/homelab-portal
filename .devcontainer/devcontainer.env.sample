# Local development secrets — copy this file to devcontainer.env and fill in the values.
# devcontainer.env is gitignored. In GitHub Codespaces, set these as repository Codespaces secrets instead.
#
# Format: one NAME=value per line, nothing after the value. Docker keeps quotes and a trailing
# "# comment" as part of the value. The file is read only when the container is created: after a
# change, run "Rebuild Container".
#
# Only needed for a custom debug keystore; leave unset to use the default
# ANDROID_DEBUG_KEYSTORE_PASSWORD=
# GitHub personal access token for gh CLI (https://github.com/settings/tokens)
# GITHUB_TOKEN=
