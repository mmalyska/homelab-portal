{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mmalyska/renovate-config"
  ],
  "timezone": "CET",
  "gitAuthor": "bendo-bot <126472327+bendo-bot[bot]@users.noreply.github.com>",
  "reviewers": ["mmalyska"],
  "packageRules": [
    {
      "description": "Wait 3 days before npm patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Wait 3 days before minor updates for dev tools (no native code)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": [
        "eslint",
        "/^eslint-.*/",
        "/^@eslint\\/.*/",
        "/^@eslint-.*/",
        "prettier",
        "typescript",
        "/^@types\\/.*/",
        "/^@tanstack\\/.*/",
        "/^@typescript-eslint\\/.*/",
        "babel-jest",
        "jest"
      ],
      "minimumReleaseAge": "3 days"
    }
  ]
}
